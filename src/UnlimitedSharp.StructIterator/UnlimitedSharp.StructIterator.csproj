<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>true</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    
    <IgnoresAccessChecksAssemblyNames>Microsoft.CodeAnalysis;Microsoft.CodeAnalysis.CSharp</IgnoresAccessChecksAssemblyNames>
    <UseEmptyMethodBody>false</UseEmptyMethodBody>
    
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <NoWarn>RS1025;RS1026</NoWarn>

    <PackageId>UnlimitedSharp.StructIterator</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <Authors>BlinD-HuNTeR</Authors>
    <Description>Enables the use of yield return in methods that return struct types (zero-allocation iterators).</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>generic yield return iterator struct linq metaprogramming roslyn extensions</PackageTags>
    <RepositoryUrl>https://github.com/BlinD-HuNTeR/UnlimitedSharp</RepositoryUrl>
    <PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.7.0" PrivateAssets="all" />
    <PackageReference Include="Easy.Tool.IgnoresAccessChecks" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="System.Collections.Immutable" Version="8.0.0" PrivateAssets="all" />
    <PackageReference Include="System.Reflection.Emit" Version="4.7.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UnlimitedSharp.SuppressVirtualCalls\UnlimitedSharp.SuppressVirtualCalls.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\UnlimitedSharp.SuppressBaseConstructor\UnlimitedSharp.SuppressBaseConstructor.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Update="README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
